# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the API (the Next.js client uses 3000)
PORT=5000

# Full MongoDB connection string (Atlas: mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority)
MONGODB_URI=

# Database for this app. Do NOT reuse zap_shift_db (legacy parcel data).
DB_NAME=ecommerce_db

# Firebase Admin service-account JSON, base64-encoded (see keyconvert.js)
FB_SERVICE_KEY=

# Comma-separated list of browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:3000
